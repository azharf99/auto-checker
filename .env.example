# URL utama LMS Algonova
ALGONOVA_BASE_URL=https://lms.algonova.id

# Kredensial Guru LMS Algonova
ALGONOVA_USERNAME=usernmae_here
ALGONOVA_PASSWORD=your_password_here

# Kredensial Login Web Dashboard (Jika kosong, default mengikuti ALGONOVA_USERNAME & ALGONOVA_PASSWORD)
DASHBOARD_USERNAME=usernmae_here
DASHBOARD_PASSWORD=your_dashboard_password_here
SESSION_TTL_HOURS=168

# Lokasi file database SQLite (otomatis dibuat jika belum ada)
DB_PATH=data/autochecker.db

# Opsional: Cookie string langsung dari browser (jika ingin bypass form login)
ALGONOVA_COOKIES=

# File penyimpanan sesi cookie cadangan (otomatis dimigrasikan ke SQLite)
ALGONOVA_COOKIE_FILE=cookies.json

# Mode pencarian tugas kuning:
# - unreviewed : Shortcut cepat via /platform/api/v2/task/unreviewed-list
# - schedule   : Telusuri halaman Jadwal -> Grup -> Tab Progress
# - both       : Gabungkan keduanya
DISCOVERY_MODE=unreviewed

# Rentang jadwal untuk mode schedule: current (Minggu ini) | all (Semua) | past (Minggu lalu)
SCHEDULE_TIMEFRAME=current

# Filter opsional Group ID tertentu (pisahkan dengan koma, kosongkan untuk semua grup)
GROUP_IDS=

# Jika true pada mode unreviewed, hanya proses grup yang muncul di jadwal aktif
ONLY_SCHEDULED_GROUPS=false

# Mode aman: true = hanya baca/simulasi (0 POST), false = eksekusi POST nyata
DRY_RUN=true

# Jeda antar HTTP request (ms) dan jeda antar level (ms) agar aman dari rate-limiter
REQUEST_DELAY_MS=650
LEVEL_DELAY_MS=1500
MAX_RETRIES=5

# Konfigurasi Web Dashboard & Built-in Cron Scheduler (saat dijalankan dengan --serve / Docker)
SERVER_ADDR=:8080
ENABLE_CRON=false
CRON_INTERVAL=6h
CRON_AUTO_EXECUTE=false
